{
  "name": "Zerøbyte Admin Console",
  "short_name": "Zerøbyte Admin",
  "description": "A protected platform operations console for Zerøbyte Business.",
  "id": "./admin.html",
  "start_url": "./admin.html",
  "scope": "./admin.html",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "background_color": "#071d12",
  "theme_color": "#0a1811",
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}