{
  "name": "zerobyte-business",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:open": "vite --open",
    "check": "npm run lint && npm run build",
    "build": "tsc -b && vite build && node scripts/prepare-pages.mjs",
    "check:env": "node scripts/check-env.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "supabase:push": "supabase db push --linked --include-all",
    "supabase:functions:deploy": "supabase functions deploy create-sale --no-verify-jwt",
    "supabase:functions:deploy:admin": "supabase functions deploy list-platform-users --no-verify-jwt",
    "supabase:functions:deploy:admin-users": "supabase functions deploy manage-platform-user --no-verify-jwt",
    "supabase:functions:deploy:worker": "supabase functions deploy provision-worker --no-verify-jwt",
    "supabase:functions:deploy:worker-login": "supabase functions deploy resolve-worker-login --no-verify-jwt",
    "supabase:functions:deploy:audit": "supabase functions deploy list-platform-audit --no-verify-jwt",
    "supabase:functions:deploy:deactivate-worker": "supabase functions deploy deactivate-worker --no-verify-jwt",
    "supabase:functions:deploy:platform-records": "supabase functions deploy get-platform-records --no-verify-jwt",
    "supabase:functions:deploy:health-ping": "supabase functions deploy platform-health-ping --no-verify-jwt",
    "supabase:functions:deploy:hardened": "npm run supabase:functions:deploy && npm run supabase:functions:deploy:worker-login && npm run supabase:functions:deploy:deactivate-worker && npm run supabase:functions:deploy:admin-users && npm run supabase:functions:deploy:platform-records && npm run supabase:functions:deploy:health-ping"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "supabase": "^2.116.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
