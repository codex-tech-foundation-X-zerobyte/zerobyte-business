VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_EMAILS=
# Cloudflare Turnstile SITE key (public, free). Turns on the human check on sign-up, sign-in and the promoter form.
# The matching SECRET goes in Supabase (Auth > Attack Protection) and as the function secret TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=

# Optional browser-observed deployment URL (GitHub is checked server-side)
VITE_VERCEL_PROJECT_URL=

# Supabase Edge Function secrets (set with `supabase secrets set`, never as VITE_* variables)
# These are read only by list-platform-audit; do not put them in frontend env files.
GITHUB_REPOSITORY=owner/repository
# Optional fine-grained GitHub token with read-only Actions, Contents, Pull requests,
# and Deployments access. Without it, public repositories use GitHub's lower rate limit.
GITHUB_TOKEN=

# Optional: HTTPS endpoint that receives client-side error reports (JSON POST).
VITE_ERROR_REPORT_ENDPOINT=

# Optional: your support WhatsApp number (international format, e.g. 2348031234567). Adds a chat button to the promoter dashboard.
VITE_SUPPORT_WHATSAPP=

# WhatsApp channel people are invited to follow after registering (optional; the invitation is hidden when this is empty).
# Example: https://whatsapp.com/channel/XXXXXXXXXXXX
VITE_WHATSAPP_CHANNEL_URL=

# --- Company details shown on the Terms, Privacy and Cookie pages (set these BEFORE launch) ---
# Use your real registered business name, the address on your CAC registration, and a mailbox you actually read.
# Without them the legal pages show only "Zerobyte" and no address or email, which looks unfinished.
VITE_COMPANY_NAME=
VITE_COMPANY_ADDRESS=
VITE_SUPPORT_EMAIL=

# --- Codex Workspace link (Edge Function secrets, set with `supabase secrets set`; never VITE_* variables) ---
# CODEX_FUNCTIONS_URL=https://<workspace-ref>.supabase.co/functions/v1
# MONITOR_KEY=ctfm_...            (Super Monitor, from Workspace -> Super Monitor -> Setup)
# SUPPORT_KEY=ctfs_...            (Customer Service, from Workspace -> Support desk -> Connected projects)
# CODEX_HEARTBEAT_SECRET=...      (any long random text; the schedule that calls codex-heartbeat sends it)

# --- Search engines and analytics (build-time variables; set them in the hosting dashboard, then redeploy) ---
# VITE_SITE_URL=https://app.yourdomain.com          the public address, https, no trailing slash (needed for sitemap and canonical links)
# VITE_GOOGLE_SITE_VERIFICATION=                    the content="..." value Google Search Console gives for the HTML tag method
# VITE_BING_SITE_VERIFICATION=                      the content="..." value Bing Webmaster Tools gives for the HTML meta tag method (msvalidate.01)
# VITE_BUILDER_URL=                                 optional: the builder's own website (https only). Listed in the search-engine data and on the About page
# VITE_BUILDER_SAME_AS=                             optional: comma-separated public profiles of the builder (LinkedIn, X, Facebook, ...), https only
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX               Google Analytics 4 (loads only after a visitor accepts analytics cookies)

# --- Codex Workspace: Super Monitor in the browser (build-time; the monitor key can only write telemetry and can be revoked) ---
# VITE_CODEX_FUNCTIONS_URL=https://<workspace-ref>.supabase.co/functions/v1
# VITE_MONITOR_KEY=ctfm_...        (Workspace -> Super Monitor -> Setup). NEVER put the ctfs_ support key in a VITE_ variable.
# VITE_APP_VERSION=7.0.0           (optional, shown as the release in the Super Monitor)
