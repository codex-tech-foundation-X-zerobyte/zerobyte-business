VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_EMAILS=

# Optional browser-observed deployment URL (GitHub is checked server-side)
VITE_VERCEL_PROJECT_URL=

# Supabase Edge Function secrets (set with `supabase secrets set`, never as VITE_* variables)
# These are read only by list-platform-audit; do not put them in frontend env files.
GITHUB_REPOSITORY=owner/repository
# Optional fine-grained GitHub token with read-only Actions, Contents, Pull requests,
# and Deployments access. Without it, public repositories use GitHub's lower rate limit.
GITHUB_TOKEN=

# Optional: HTTPS endpoint that receives client-side error reports (JSON POST).
VITE_ERROR_REPORT_ENDPOINT=

# Optional: your support WhatsApp number (international format, e.g. 2348031234567). Adds a chat button to the promoter dashboard.
VITE_SUPPORT_WHATSAPP=
